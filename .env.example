# ===== PHP (build-time, requires rebuild) =====
# Supported: 7.3, 7.4, 8.0, 8.1, 8.2, 8.3
PHP_VERSION=7.3

# ===== phpMyAdmin =====
PMA_ENABLED=true
PMA_ADMIN_USER=pma_admin
PMA_ADMIN_PASS=change_me

# ===== Redis =====
REDIS_ENABLED=true

# ===== FTP =====
FTP_ENABLED=false
FTP_USER=dev
FTP_PASS=change_me
